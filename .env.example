# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cards

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-to-a-long-random-string

# CORS
ALLOWED_ORIGIN=http://localhost:8000

# Stripe — get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_SOCIAL_YEARLY=price_xxx
STRIPE_PRICE_CORPORATE_YEARLY=price_xxx
STRIPE_PRICE_TAGLINK_MONTHLY=price_xxx

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@uwitz.cards
SMTP_PASS=your-smtp-password
SMTP_FROM=Uwitz Cards <noreply@uwitz.cards>

# Entra ID (client secret is server-side only)
ENTRA_CLIENT_ID=bf993ac3-0ca5-4172-9617-0e8851d5de1d
ENTRA_CLIENT_SECRET=your-entra-client-secret
ENTRA_TENANT_ID=7625c8c5-0680-4ccc-8840-dc993791d475

# Irys SSO
IRYS_CLIENT_ID=your-irys-client-id
IRYS_CLIENT_SECRET=your-irys-client-secret

# Site
SITE_URL=http://localhost:8000
LOG_LEVEL=INFO
