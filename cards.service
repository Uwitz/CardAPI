[Unit]
Description=Card API Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/snyco/CardAPI
ExecStart=/home/snyco/CardAPI/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
EnvironmentFile=/home/snyco/CardAPI/.env

[Install]
WantedBy=multi-user.target
